@echo off
setlocal EnableExtensions DisableDelayedExpansion
rem Best-effort append-only key/value launcher log. Logging failures must never change the
rem launcher's own exit code or block a PAPER/READ-ONLY workflow.
set "LAUNCHER_LOG_NAME=%~1"
set "LAUNCHER_LOG_EVENT=%~2"
set "LAUNCHER_LOG_PHASE=%~3"
set "LAUNCHER_LOG_OPERATION=%~4"
set "LAUNCHER_LOG_EXIT_CODE=%~5"
set "LAUNCHER_LOG_RETURN_CODE=0"
if not "%~5"=="" set "LAUNCHER_LOG_RETURN_CODE=%~5"
set "LAUNCHER_LOG_ROOT=%~dp0.."
set "LAUNCHER_LOG_PATH=%~dp0..\runtime\logs\launchers\%~1.log"
set "LAUNCHER_LOG_GLOBAL_PATH=%~dp0..\runtime\logs\launchers\ALL_LAUNCHERS.log"
if not defined ALINA_LAUNCH_RUN_ID set "ALINA_LAUNCH_RUN_ID=unavailable"
if not defined ALINA_LAUNCH_MODE set "ALINA_LAUNCH_MODE=unspecified"
if not defined ALINA_LAUNCH_PYTHON set "ALINA_LAUNCH_PYTHON=unresolved"
if not defined ALINA_LAUNCH_OUTPUT_LOG set "ALINA_LAUNCH_OUTPUT_LOG=not-declared"
set "LAUNCHER_LOG_SAFE_MODE=%HL_ENV%"
set "LAUNCHER_LOG_MAINNET_EXECUTION=%HL_ENABLE_MAINNET_EXECUTION%"
set "LAUNCHER_LOG_TESTNET_EXECUTION=%HL_ENABLE_TESTNET_EXECUTION%"
if not defined LAUNCHER_LOG_SAFE_MODE set "LAUNCHER_LOG_SAFE_MODE=unset"
if not defined LAUNCHER_LOG_MAINNET_EXECUTION set "LAUNCHER_LOG_MAINNET_EXECUTION=unset"
if not defined LAUNCHER_LOG_TESTNET_EXECUTION set "LAUNCHER_LOG_TESTNET_EXECUTION=unset"
set "LAUNCHER_LOG_CLOCK=%TIME: =0%"
set "LAUNCHER_LOG_HH=%LAUNCHER_LOG_CLOCK:~0,2%"
set "LAUNCHER_LOG_MM=%LAUNCHER_LOG_CLOCK:~3,2%"
set "LAUNCHER_LOG_SS=%LAUNCHER_LOG_CLOCK:~6,2%"
set "LAUNCHER_LOG_CC=%LAUNCHER_LOG_CLOCK:~9,2%"
set /a LAUNCHER_LOG_NOW_CS=(1%LAUNCHER_LOG_HH%-100)*360000+(1%LAUNCHER_LOG_MM%-100)*6000+(1%LAUNCHER_LOG_SS%-100)*100+(1%LAUNCHER_LOG_CC%-100) >nul 2>nul
if not defined ALINA_LAUNCH_TIMING_RUN_ID set "ALINA_LAUNCH_TIMING_RUN_ID=%ALINA_LAUNCH_RUN_ID%"
if not "%ALINA_LAUNCH_TIMING_RUN_ID%"=="%ALINA_LAUNCH_RUN_ID%" (
  set "ALINA_LAUNCH_START_CS=%LAUNCHER_LOG_NOW_CS%"
  set "ALINA_LAUNCH_LAST_CS=%LAUNCHER_LOG_NOW_CS%"
  set "ALINA_LAUNCH_LOG_SEQUENCE=0"
  set "ALINA_LAUNCH_TIMING_RUN_ID=%ALINA_LAUNCH_RUN_ID%"
)
if not defined ALINA_LAUNCH_START_CS set "ALINA_LAUNCH_START_CS=%LAUNCHER_LOG_NOW_CS%"
if not defined ALINA_LAUNCH_LAST_CS set "ALINA_LAUNCH_LAST_CS=%LAUNCHER_LOG_NOW_CS%"
set /a LAUNCHER_LOG_ELAPSED_CS=LAUNCHER_LOG_NOW_CS-ALINA_LAUNCH_START_CS >nul 2>nul
set /a LAUNCHER_LOG_DELTA_CS=LAUNCHER_LOG_NOW_CS-ALINA_LAUNCH_LAST_CS >nul 2>nul
if %LAUNCHER_LOG_ELAPSED_CS% LSS 0 set /a LAUNCHER_LOG_ELAPSED_CS+=8640000 >nul 2>nul
if %LAUNCHER_LOG_DELTA_CS% LSS 0 set /a LAUNCHER_LOG_DELTA_CS+=8640000 >nul 2>nul
set /a LAUNCHER_LOG_ELAPSED_MS=LAUNCHER_LOG_ELAPSED_CS*10 >nul 2>nul
set /a LAUNCHER_LOG_DELTA_MS=LAUNCHER_LOG_DELTA_CS*10 >nul 2>nul
set "LAUNCHER_LOG_SLOW=0"
if %LAUNCHER_LOG_DELTA_MS% GEQ 5000 set "LAUNCHER_LOG_SLOW=1"
if not defined ALINA_LAUNCH_LOG_SEQUENCE set "ALINA_LAUNCH_LOG_SEQUENCE=0"
set /a ALINA_LAUNCH_LOG_SEQUENCE+=1 >nul 2>nul
set "LAUNCHER_LOG_SEQUENCE=%ALINA_LAUNCH_LOG_SEQUENCE%"
set "LAUNCHER_LOG_STATUS=INFO"
if /I "%LAUNCHER_LOG_EVENT%"=="START" set "LAUNCHER_LOG_STATUS=STARTED"
if /I "%LAUNCHER_LOG_EVENT%"=="STEP" set "LAUNCHER_LOG_STATUS=RUNNING"
if /I "%LAUNCHER_LOG_EVENT%"=="RESULT" set "LAUNCHER_LOG_STATUS=UNKNOWN"
if /I "%LAUNCHER_LOG_EVENT%"=="EXIT" set "LAUNCHER_LOG_STATUS=UNKNOWN"
if /I "%LAUNCHER_LOG_EVENT%"=="SUMMARY" set "LAUNCHER_LOG_STATUS=INFO"
if /I "%LAUNCHER_LOG_EVENT%"=="RESULT" if "%LAUNCHER_LOG_EXIT_CODE%"=="0" set "LAUNCHER_LOG_STATUS=SUCCESS"
if /I "%LAUNCHER_LOG_EVENT%"=="RESULT" if not "%LAUNCHER_LOG_EXIT_CODE%"=="" if not "%LAUNCHER_LOG_EXIT_CODE%"=="0" set "LAUNCHER_LOG_STATUS=FAILURE"
if /I "%LAUNCHER_LOG_EVENT%"=="EXIT" if "%LAUNCHER_LOG_EXIT_CODE%"=="0" set "LAUNCHER_LOG_STATUS=SUCCESS"
if /I "%LAUNCHER_LOG_EVENT%"=="EXIT" if not "%LAUNCHER_LOG_EXIT_CODE%"=="" if not "%LAUNCHER_LOG_EXIT_CODE%"=="0" set "LAUNCHER_LOG_STATUS=FAILURE"
if /I "%LAUNCHER_LOG_EVENT%"=="SUMMARY" if "%LAUNCHER_LOG_EXIT_CODE%"=="0" set "LAUNCHER_LOG_STATUS=SUCCESS"
if /I "%LAUNCHER_LOG_EVENT%"=="SUMMARY" if not "%LAUNCHER_LOG_EXIT_CODE%"=="" if not "%LAUNCHER_LOG_EXIT_CODE%"=="0" set "LAUNCHER_LOG_STATUS=FAILURE"
set "LAUNCHER_LOG_NEXT_ACTION=none"
if "%LAUNCHER_LOG_SLOW%"=="1" set "LAUNCHER_LOG_NEXT_ACTION=profile-phase-and-check-io"
if /I "%LAUNCHER_LOG_STATUS%"=="FAILURE" set "LAUNCHER_LOG_NEXT_ACTION=inspect-output-log-and-previous-events"
if not exist "%~dp0..\runtime\logs\launchers" mkdir "%~dp0..\runtime\logs\launchers" >nul 2>nul
rem Delayed expansion is enabled only while writing. Metacharacters in a path or an
rem operation label are then data, not a second command accidentally parsed by cmd.exe.
setlocal EnableDelayedExpansion
set "LAUNCHER_LOG_RECORD=log_schema="3" timestamp_local="!DATE! !TIME!" run_id="!ALINA_LAUNCH_RUN_ID!" sequence="!LAUNCHER_LOG_SEQUENCE!" launcher="!LAUNCHER_LOG_NAME!" event="!LAUNCHER_LOG_EVENT!" status="!LAUNCHER_LOG_STATUS!" phase="!LAUNCHER_LOG_PHASE!" operation="!LAUNCHER_LOG_OPERATION!" exit_code="!LAUNCHER_LOG_EXIT_CODE!" elapsed_ms="!LAUNCHER_LOG_ELAPSED_MS!" since_previous_ms="!LAUNCHER_LOG_DELTA_MS!" slow="!LAUNCHER_LOG_SLOW!" next_action="!LAUNCHER_LOG_NEXT_ACTION!" mode="!ALINA_LAUNCH_MODE!" cwd="!CD!" root="!LAUNCHER_LOG_ROOT!" python="!ALINA_LAUNCH_PYTHON!" output_log="!ALINA_LAUNCH_OUTPUT_LOG!" safe_mode="!LAUNCHER_LOG_SAFE_MODE!" mainnet_execution="!LAUNCHER_LOG_MAINNET_EXECUTION!" testnet_execution="!LAUNCHER_LOG_TESTNET_EXECUTION!" os="!OS!" architecture="!PROCESSOR_ARCHITECTURE!""
>>"!LAUNCHER_LOG_PATH!" echo(!LAUNCHER_LOG_RECORD!
>>"!LAUNCHER_LOG_GLOBAL_PATH!" echo(!LAUNCHER_LOG_RECORD!
endlocal
endlocal & set "ALINA_LAUNCH_LOG_SEQUENCE=%LAUNCHER_LOG_SEQUENCE%" & set "ALINA_LAUNCH_START_CS=%ALINA_LAUNCH_START_CS%" & set "ALINA_LAUNCH_LAST_CS=%LAUNCHER_LOG_NOW_CS%" & set "ALINA_LAUNCH_TIMING_RUN_ID=%ALINA_LAUNCH_TIMING_RUN_ID%" & exit /b %LAUNCHER_LOG_RETURN_CODE%
