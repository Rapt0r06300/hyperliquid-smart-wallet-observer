# [PORTABILITE] Les scripts Windows DOIVENT etre en CRLF sur le disque, quel que soit l'OS de
# checkout (un .cmd/.bat en LF peut mal se comporter sous cmd.exe). eol=crlf le garantit partout.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
# Les scripts POSIX restent en LF.
*.sh text eol=lf

*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
