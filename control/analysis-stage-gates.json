      ],
      "required_coverage": {
        "trade_count_exact": true,
        "unique_trade_count_exact": true,
        "uncompressed_bytes_exact": true,
        "valid_record_count_exact": true,
        "unique_record_count_exact": true
      }
    },
    "REPLAY": {
      "required_files": [
        "catalog/DATASET_HEALTH_RECEIPT.json"
      ],
      "required_coverage": {
        "trade_count_exact": true,
        "unique_trade_count_exact": true,
        "uncompressed_bytes_exact": true,
        "valid_record_count_exact": true,
        "unique_record_count_exact": true
      }
    },
    "BACKTEST": {
