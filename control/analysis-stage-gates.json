        "replay"
      ]
    },
    "OOS": {
      "required_campaign_kinds": [
        "backtest"
      ]
    },
    "FORWARD_PAPER": {
      "required_campaign_kinds": [
        "oos"
      ]
    },
    "PNL_PROOF": {
